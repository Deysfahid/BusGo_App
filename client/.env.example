# BusGo frontend environment (public values only)

# API + WebSocket origins (leave blank for same-origin dev via the Vite proxy)
VITE_API_URL=
VITE_WS_URL=

# Firebase (Google Sign-In identity only). These web-config values are PUBLIC.
# Get them from Firebase Console -> Project settings -> Your apps -> Web app.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
