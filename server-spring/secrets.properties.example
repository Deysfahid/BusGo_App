# Copy to secrets.properties and fill in your own local values.
#   cp secrets.properties.example secrets.properties
#
# secrets.properties is gitignored. In production these are set as environment
# variables in the Render dashboard instead, which take precedence over this file.

DB_URL=jdbc:postgresql://localhost:5432/busgo_dev
DB_USERNAME=postgres
DB_PASSWORD=your-local-postgres-password

# At least 32 characters - HS512 needs a 256-bit key and jjwt rejects weaker ones.
# Generate one with:  openssl rand -hex 32
APP_JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars
